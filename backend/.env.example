# ─── Usado cuando Spring Boot corre fuera de Docker ───────────────────────────
# Requiere PostgreSQL y Redis corriendo localmente o via docker compose up
SPRING_PROFILES_ACTIVE=local

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vantan_db
DB_USER=vantan_user
DB_PASSWORD=change_me_in_env

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_env

JWT_SECRET=change_me_to_a_256bit_secret_minimum_32_characters
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000