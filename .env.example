# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=vantan_db
POSTGRES_USER=vantan_user
POSTGRES_PASSWORD=change_me_in_env

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_env

# ─── Spring Boot (cuando corre dentro de Docker) ──────────────────────────────
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=change_me_to_a_256bit_secret_minimum_32_characters
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000